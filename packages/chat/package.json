{
  "name": "@opentiny/tiny-robot-chat",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    },
    "./style": {
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "scripts": {
    "dev": "vue-tsc && vite build --watch",
    "build": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit",
    "check:docs": "node ./scripts/check-refactor-docs.mjs",
    "test": "node ./tests/run-all.mjs",
    "test:unit": "node ./tests/run-all.mjs",
    "test:runtime": "node ./tests/run-all.mjs ./tests/runtime",
    "test:integration": "node ./tests/run-all.mjs ./tests/integration",
    "test:contracts": "node ./tests/run-all.mjs ./tests/contracts",
    "check:phase-1a": "vue-tsc --noEmit && node ./tests/run-all.mjs ./tests/runtime && node ./tests/run-all.mjs ./tests/contracts && node ./scripts/check-refactor-docs.mjs",
    "check:demo": "pnpm -C ./demo build",
    "check:phase-4": "vue-tsc --noEmit && node ./tests/run-all.mjs ./tests/runtime && node ./tests/run-all.mjs ./tests/contracts && node ./tests/run-all.mjs ./tests/integration && pnpm -C ./demo build && node ./scripts/check-refactor-docs.mjs"
  },
  "peerDependencies": {
    "vue": "^3.3.11",
    "markstream-vue": "^0.0.9-beta.0",
    "@opentiny/tiny-robot": "workspace:*",
    "@opentiny/tiny-robot-kit": "workspace:*"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.5",
    "@opentiny/tiny-robot-svgs": "workspace:*",
    "@vueuse/core": "^13.1.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "less": "^4.2.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.3.11",
    "vue-tsc": "^2.2.8"
  }
}
