# ============================================================
# 阿里云百炼 (DashScope / Bailian) — 推荐
# 控制台获取 API Key: https://bailian.console.aliyun.com/
# 模型列表: https://help.aliyun.com/zh/model-studio/models
# ============================================================
VITE_BAILIAN_API_KEY=your_bailian_api_key_here
# 默认使用 qwen-plus，可替换为 qwen-max / qwen-turbo / qwen-vl-plus 等
VITE_BAILIAN_MODEL=qwen-plus

# ============================================================
# DeepSeek — 备选
# ============================================================
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_DEEPSEEK_MODEL=deepseek-chat
