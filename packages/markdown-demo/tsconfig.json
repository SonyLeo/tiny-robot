{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "lib": ["ES2022.Intl", "ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node", "dom-speech-recognition"],
    "typeRoots": ["../components/node_modules/@types", "../../node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@opentiny/tiny-robot": ["../components/src/index.ts"],
      "@opentiny/tiny-robot-svgs": ["../svgs/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../components/src/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
